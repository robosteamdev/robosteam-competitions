# Copy to `.env` in this directory (the git root) and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# Required: SECRET_KEY, MQTT_USERNAME, MQTT_PASSWORD. Django refuses to start
# without them (Phase G2 removed the built-in SECRET_KEY fallback on purpose).

# ── Django core ──────────────────────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://competitions.robosteam.eu
STATIC_ROOT=./static

# SQLite for dev; mysql://user:password@host:3306/dbname in production.
# On SQLite the settings module forces WAL + IMMEDIATE transactions, because
# Daphne, mqtt_bridge and timeout_runs all write concurrently. For a real event
# with many teams, prefer MySQL.
DATABASE_URL=sqlite:///db.sqlite3
# Seconds a SQLite writer waits for the lock before giving up (SQLite only).
SQLITE_TIMEOUT=30

# ── HTTPS ────────────────────────────────────────────────────────────────────
# Turn on ONLY once TLS terminates in front of Django (Nginx). It switches on
# SECURE_SSL_REDIRECT and Secure session/CSRF cookies together — on a plain-HTTP
# deployment those lock everyone out and loop redirects. Part of the DNS cutover.
USE_HTTPS=False
# Raise to e.g. 31536000 (1 year) only after the certificate renews cleanly once.
# Browsers cache HSTS, so a wrong value is painful to undo.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_PRELOAD=False

# ── Channels ─────────────────────────────────────────────────────────────────
# Required for a real deployment: the mqtt_bridge and timeout_runs processes push
# scoreboard updates through this layer. Leave empty and each process gets its own
# in-memory layer, so browsers never see lap events (finding C2).
REDIS_URL=redis://127.0.0.1:6379/0
# Must stay well above channels_redis's 5s BRPOP window, or idle board
# WebSockets are killed by a redis read timeout. Only lower it if you know why.
REDIS_SOCKET_TIMEOUT=60

# ── MQTT broker ──────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=<broker-address>
MQTT_BROKER_PORT=1883
MQTT_USERNAME=<mqtt-user>
MQTT_PASSWORD=change-me

# ── Devices ──────────────────────────────────────────────────────────────────
# Seconds of silence before the sweep in `timeout_runs` marks a device OFFLINE.
DEVICE_OFFLINE_SECONDS=90
# Shared secret for POST /devices/register/. Empty = open on the competition LAN
# (devices still need admin approval before they can score).
DEVICE_REG_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# Default is the console backend (dev). Set these for real password-reset mail.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@robosteam.eu
